{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "resolver",
  "share": "disabled",
  "instructions": [
    "AGENTS.md",
    "SECURITY.md"
  ],
  "agent": {
    "build": {
      "disable": true
    },
    "plan": {
      "disable": true
    }
  },
  "server": {
    "hostname": "0.0.0.0",
    "port": 4096
  },
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*.pem": "deny",
      "*.key": "deny",
      "*.p12": "deny",
      "*.pfx": "deny",
      "*credential*": "deny",
      "*secret*": "deny",
      "**/.ssh/**": "deny",
      "**/.kube/**": "deny",
      "**/.gcloud/**": "deny",
      "**/.gnupg/**": "deny"
    },
    "bash": {
      "cat *.env*": "deny",
      "cat *.pem": "deny",
      "cat *.key": "deny",
      "env": "deny",
      "printenv *": "deny",
      "export *": "deny"
    }
  },
  "plugin": [
    "opencode-plugin-openspec"
  ]
}