{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "resolver",
  "share": "disabled",
  "instructions": [
    "AGENTS.md"
  ],
  "agents": {
    "build": {
      "disabled": true
    },
    "plan": {
      "disabled": true
    },
    "researcher": {
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" }
      ]
    },
    "reviewer": {
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" }
      ]
    },
    "security_reviewer": {
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" }
      ]
    },
    "spec_author": {
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "edit", "resource": "openspec/**", "effect": "allow" },
        { "action": "edit", "resource": "specs/**", "effect": "allow" },
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "git commit*", "effect": "deny" },
        { "action": "shell", "resource": "git merge*", "effect": "deny" },
        { "action": "shell", "resource": "git push*", "effect": "deny" },
        { "action": "shell", "resource": "git worktree*", "effect": "deny" },
        { "action": "shell", "resource": "git checkout*", "effect": "deny" },
        { "action": "shell", "resource": "git switch*", "effect": "deny" },
        { "action": "shell", "resource": "git reset*", "effect": "deny" }
      ]
    },
    "tester": {
      "permissions": [
        { "action": "subagent", "resource": "*", "effect": "deny" }
      ]
    },
    "resolver": {
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" }
      ]
    },
    "spec_driven": {
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "git commit*", "effect": "deny" },
        { "action": "shell", "resource": "git merge*", "effect": "deny" },
        { "action": "shell", "resource": "git checkout*", "effect": "deny" },
        { "action": "shell", "resource": "git switch*", "effect": "deny" },
        { "action": "shell", "resource": "git worktree add*", "effect": "deny" },
        { "action": "shell", "resource": "git worktree remove*", "effect": "deny" },
        { "action": "shell", "resource": "git reset*", "effect": "deny" }
      ]
    }
  },
  "permissions": [
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "read", "resource": "*.env.example", "effect": "deny" },
    { "action": "read", "resource": "*.pem", "effect": "deny" },
    { "action": "read", "resource": "*.key", "effect": "deny" },
    { "action": "read", "resource": "*.p12", "effect": "deny" },
    { "action": "read", "resource": "*.pfx", "effect": "deny" },
    { "action": "read", "resource": "*credentials*", "effect": "deny" },
    { "action": "read", "resource": "*secret*", "effect": "deny" },
    { "action": "read", "resource": "**/.ssh/**", "effect": "deny" },
    { "action": "read", "resource": "**/.gcloud/**", "effect": "deny" },
    { "action": "read", "resource": "**/.gnupg/**", "effect": "deny" },
    { "action": "read", "resource": "**/.kube/**", "effect": "deny" },
    { "action": "read", "resource": "**/secrets/**", "effect": "deny" },
    { "action": "read", "resource": "**/.docker/config.json", "effect": "deny" },
    { "action": "read", "resource": "**/openspec/changes/**", "effect": "allow" },
    { "action": "read", "resource": "**/openspec/specs/**", "effect": "allow" },

    { "action": "edit", "resource": "*", "effect": "allow" },
    { "action": "edit", "resource": "*.env", "effect": "deny" },
    { "action": "edit", "resource": "*.env.*", "effect": "deny" },
    { "action": "edit", "resource": "*.env.example", "effect": "deny" },
    { "action": "edit", "resource": "*.pem", "effect": "deny" },
    { "action": "edit", "resource": "*.key", "effect": "deny" },
    { "action": "edit", "resource": "*.p12", "effect": "deny" },
    { "action": "edit", "resource": "*.pfx", "effect": "deny" },
    { "action": "edit", "resource": "*credentials*", "effect": "deny" },
    { "action": "edit", "resource": "*secret*", "effect": "deny" },
    { "action": "edit", "resource": "**/.ssh/**", "effect": "deny" },
    { "action": "edit", "resource": "**/.kube/**", "effect": "deny" },
    { "action": "edit", "resource": "**/.gcloud/**", "effect": "deny" },
    { "action": "edit", "resource": "**/.gnupg/**", "effect": "deny" },
    { "action": "edit", "resource": "**/secrets/**", "effect": "deny" },
    { "action": "edit", "resource": "**/.docker/config.json", "effect": "deny" },

    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "env", "effect": "deny" },
    { "action": "shell", "resource": "env *", "effect": "deny" },
    { "action": "shell", "resource": "printenv*", "effect": "deny" },
    { "action": "shell", "resource": "export *", "effect": "deny" },
    { "action": "shell", "resource": "export", "effect": "deny" },
    { "action": "shell", "resource": "cat *.env*", "effect": "deny" },
    { "action": "shell", "resource": "cat *.pem", "effect": "deny" },
    { "action": "shell", "resource": "cat *.key", "effect": "deny" },
    { "action": "shell", "resource": "ssh *", "effect": "deny" },
    { "action": "shell", "resource": "scp *", "effect": "deny" },
    { "action": "shell", "resource": "docker *", "effect": "deny" },
    { "action": "shell", "resource": "curl *169.254.169.254*", "effect": "deny" },
    { "action": "shell", "resource": "wget *169.254.169.254*", "effect": "deny" },
    { "action": "shell", "resource": "git push*", "effect": "deny" },
    { "action": "shell", "resource": "rm -rf /", "effect": "deny" },
    { "action": "shell", "resource": "rm -rf /*", "effect": "deny" },
    { "action": "shell", "resource": "rm -rf ~", "effect": "deny" },
    { "action": "shell", "resource": "rm -rf ~/*", "effect": "deny" },
    { "action": "shell", "resource": "rm -rf .", "effect": "deny" },
    { "action": "shell", "resource": "rm -rf ./*", "effect": "deny" },
    { "action": "shell", "resource": "rm -rf /workspace*", "effect": "deny" },
    { "action": "shell", "resource": "find / -delete*", "effect": "deny" },
    { "action": "shell", "resource": "chmod -R 777 /", "effect": "deny" },

    { "action": "webfetch", "resource": "*", "effect": "allow" },
    { "action": "websearch", "resource": "*", "effect": "allow" },
    { "action": "subagent", "resource": "*", "effect": "allow" },
    { "action": "skill", "resource": "*", "effect": "allow" },

    { "action": "external_directory", "resource": "/private/tmp/**", "effect": "allow" },
    { "action": "external_directory", "resource": "/tmp/**", "effect": "allow" },
    { "action": "external_directory", "resource": "/workspace/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.config/opencode/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/AppData/Local/Temp/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/go/pkg/mod/**", "effect": "allow" }
  ]
}
