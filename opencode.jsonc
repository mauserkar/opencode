{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "architect",
  "subagent_depth": 1,
  "agent": {
    "build": {
      "disable": true
    },
    "plan": {
      "disable": true
    }
  },
  "server": {
    "hostname": "0.0.0.0",
    "port": 4096
  },
  "plugin": [
    "opencode-plugin-openspec"
  ],
  "experimental": {
    "continue_loop_on_deny": false
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },
  "tool_output": {
    "max_lines": 500,
    "max_bytes": 20000
  }
}