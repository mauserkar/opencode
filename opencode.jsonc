{
  "$schema": "https://opencode.ai/config.json",
  "server": {
    "hostname": "0.0.0.0",
    "port": 4096
  },
  "default_agent": "resolver",
  "share": "disabled",
  "instructions": [
    "AGENTS.md",
    "SECURITY.md"
  ],
  "agent": {
    "build": {
      "disable": true
    },
    "plan": {
      "disable": true
    }
  },
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "*.p12": "deny",
      "*.pfx": "deny",
      "*credentials*": "deny",
      "*secret*": "deny",
      "**/.ssh/**": "deny",
      "**/.gcloud/**": "deny",
      "**/.gnupg/**": "deny",
      "**/.kube/**": "deny",
      "**/secrets/**": "deny",
      "**/.docker/config.json": "deny",
      "**/openspec/changes/**": "allow",
      "**/openspec/specs/**": "allow"
    },
    "edit": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "**/.ssh/**": "deny",
      "**/.kube/**": "deny"
    },
    "bash": {
      "*": "allow",
      "env": "deny",
      "printenv*": "deny",
      "export *": "deny",
      "cat *.env*": "deny",
      "cat *.pem": "deny",
      "cat *.key": "deny",
      "ssh *": "deny",
      "scp *": "deny",
      "docker *": "deny",
      "curl *169.254.169.254*": "deny",
      "wget *169.254.169.254*": "deny",
      "git push*": "deny",
      "git push --force*": "deny",
      "rm -rf /": "deny",
      "rm -rf /*": "deny",
      "rm -rf ~": "deny",
      "rm -rf ~/*": "deny",
      "rm -rf .": "deny",
      "rm -rf ./*": "deny",
      "rm -rf /workspace*": "deny",
      "find / -delete*": "deny",
      "chmod -R 777 /": "deny"
    },
    "list": {
      "~/go/pkg/mod/**": "allow"
    },
    "webfetch": "allow",
    "websearch": "allow",
    "task": "allow",
    "skill": "allow",
    "doom_loop": "deny",
    "external_directory": {
      "~/go/pkg/mod/**": "allow",
      "/tmp/**": "allow",
      "/private/tmp/**": "allow",
      "~/AppData/Local/Temp/**": "allow",
      "/workspace/*": "allow"
    }
  },
  "plugin": [
    "opencode-plugin-openspec"
  ]
}