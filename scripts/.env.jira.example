# --- Required ---------------------------------------------------------------

# Jira Bearer/API token. No default — the script will fail without it.
JIRA_TOKEN=your-jira-api-token-here

# Base URL of your Jira instance, no trailing slash. No default — this
JIRA_BASE_URL=https://your-company.atlassian.net

# --- Optional (have sane defaults, or only needed for --project/--epic) ----

# Default Jira project key used when --project is not passed on the CLI.
# Required (via this var or --project) for: create, search, list.
JIRA_PROJECT_ID=PROJ

# Default issue type for `create`. Default if unset: "Task".
JIRA_ISSUE_TYPE=Task

# Default labels for `create`, comma-separated. Default if unset: none.
JIRA_ISSUE_LABELS=backend,automated

# Default priority for `create`. Default if unset: "Medium".
JIRA_ISSUE_PRIORITY=Medium

# Default epic key to link new/updated issues to. Default if unset: none.
JIRA_ISSUE_EPIC=PROJ-1000

# Jira custom field id used for the epic link. Only required if you use
# --epic / JIRA_ISSUE_EPIC. No default. Find this in your Jira admin panel
JIRA_EPIC_FIELD=customfield_10000

# HTTP request timeout in seconds. Default if unset: 10.
JIRA_TIMEOUT=10

# Default page size for `search`/`list` (can be overridden with
# --max-results on either command). Default if unset: 50.
JIRA_MAX_RESULTS=50
