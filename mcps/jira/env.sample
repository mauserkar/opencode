# Copy to .env (in this same directory) and fill in. Never commit the real .env file.

# Required
JIRA_TOKEN=
JIRA_BASE_URL=

# Optional (defaults shown in comments)
JIRA_PROJECT_ID=
JIRA_ISSUE_TYPE=Task
JIRA_ISSUE_LABELS=
JIRA_ISSUE_PRIORITY=Medium
JIRA_ISSUE_EPIC=
# Required only if JIRA_ISSUE_EPIC / --epic is used (e.g. customfield_10014)
JIRA_EPIC_FIELD=
JIRA_TIMEOUT=10
JIRA_MAX_RESULTS=50