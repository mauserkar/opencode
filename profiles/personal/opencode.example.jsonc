{
  // Personal profile — activate with:
  //   export OPENCODE_CONFIG=~/.config/opencode/profiles/personal/opencode.jsonc
  // Merged on top of the global config (~/.config/opencode/opencode.jsonc),
  // so only include the settings that differ for personal use.
  "$schema": "https://opencode.ai/config.json",
  "model": "deepseek/deepseek-flash",
  "small_model": "deepseek/deepseek-flash",
  "agents": {
    "spec_driven": {
      "disabled": true
    },
    "unattended": {
      "model": "deepseek/deepseek-flash"
    },
    "researcher": {
      "disabled": true
    },
    "spec_author": {
      "disabled": true
    },
    "developer": {
      "model": "deepseek/deepseek-flash"
    },
    "tester": {
      "disabled": true
    },
    "reviewer": {
      "disabled": true
    },
    "security_reviewer": {
      "disabled": true
    },
    "resolver": {
      "model": "deepseek/deepseek-flash"
    }
  }
}
