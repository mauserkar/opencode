{
  "$schema": "https://opencode.ai/config.json",
  "model": "google-vertex/claude-sonnet-5",
  "small_model": "google-vertex/gemini-3.8-flash",
  "share": "disabled",
  "default_agent": "resolver",
  "disabled_providers": [
    "opencode"
  ],
  "permissions": [
    { "action": "websearch", "resource": "*", "effect": "deny" }
  ],
  "agents": {
    "build": {
      "disabled": true
    },
    "plan": {
      "disabled": true
    },
    "developer": {
      "model": "google-vertex/claude-sonnet-5"
    },
    "researcher": {
      "model": "google-vertex/gemini-3.8-flash"
    },
    "resolver": {
      "model": "google-vertex/claude-sonnet-5"
    },
    "reviewer": {
      "model": "google-vertex/gemini-3.8-flash"
    },
    "security_reviewer": {
      "model": "google-vertex/gemini-3.8-flash"
    },
    "spec_author": {
      "model": "google-vertex/gemini-3.8-flash"
    },
    "spec_driven": {
      "model": "google-vertex/claude-sonnet-5"
    },
    "tester": {
      "model": "google-vertex/gemini-3.8-flash"
    },
    "unattended": {
      "model": "google-vertex/claude-sonnet-5"
    }
  },
  "mcp": {
    "servers": {
      "jira": {
        "type": "remote",
        "url": "http://opencode-mcp-jira:8000/mcp"
      }
    }
  }
}
