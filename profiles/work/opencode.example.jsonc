{
  "$schema": "https://opencode.ai/config.json",
  "model": "google-vertex/claude-sonnet-5@default",
  "small_model": "google-vertex/gemini-3.8-flash",
  "share": "disabled",
  "default_agent": "resolver",
  "disabled_providers": [
    "opencode"
  ],
  "permission": {
    "websearch": "deny"
  },
  "agent": {
    "build": {
      "disable": true
    },
    "plan": {
      "disable": true
    },
    "developer": {
      "model": "google-vertex/claude-sonnet-5@default"
    },
    "researcher": {
      "model": "google-vertex/gemini-3.8-flash"
    },
    "resolver": {
      "model": "google-vertex/claude-sonnet-5@default"
    },
    "reviewer": {
      "model": "google-vertex/gemini-3.8-flash"
    },
    "security_reviewer": {
      "model": "google-vertex/gemini-3.8-flash"
    },
    "spec_author": {
      "model": "google-vertex/gemini-3.8-flash"
    },
    "spec_driven": {
      "model": "google-vertex/claude-sonnet-5@default"
    },
    "tester": {
      "model": "google-vertex/gemini-3.8-flash"
    },
    "unattended": {
      "model": "google-vertex/claude-sonnet-5@default"
    }
  },
  "mcp": {
    "jira": {
      "type": "remote",
      "url": "http://opencode-mcp-jira:8000/mcp",
      "enabled": true
    }
  }
}