# --- Required ---
REPO_NAME=                     # Name of the repository to mount (path: $HOME/repos/<REPO_NAME>)

# --- Profile ---
OPENCODE_PROFILE=personal      # Which config profile to load: work | personal

# --- Server ---
OPENCODE_HOST_PORT=            # Host port where the OpenCode server is exposed (default: 4096)
OPENCODE_SERVER_USERNAME=      # Username for authenticating with the OpenCode server
OPENCODE_SERVER_PASSWORD=      # Password for authenticating with the OpenCode server
# NOTE: these are passed as container environment variables and are therefore
# visible via `docker inspect`. Treat this file as a secret and never commit it.

# --- Optional resource limits ---
OPENCODE_MEM_LIMIT=4g          # Container memory limit (default: 4g)
OPENCODE_CPUS=2.0              # CPU limit (default: 2.0)
